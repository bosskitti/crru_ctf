# CRRU CTF Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# === Flask ===
SECRET_KEY=change-me-to-a-random-secret-key

# === Database ===
DATABASE_URL=mysql+pymysql://ctfd:ctfd_password@db/ctfd
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_USER=ctfd
MARIADB_PASSWORD=change-me-db-password
MARIADB_DATABASE=ctfd

# === Redis ===
REDIS_URL=redis://cache:6379

# === Cloudflare Tunnel ===
# Get token from Cloudflare Zero Trust > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# === OpenVPN (Node B) ===
# Public IP or hostname of Node B VPN server
OPENVPN_REMOTE_HOST=
OPENVPN_REMOTE_PORT=1194

# === FRP Reverse Proxy ===
FRP_TOKEN=change-me-frp-token


